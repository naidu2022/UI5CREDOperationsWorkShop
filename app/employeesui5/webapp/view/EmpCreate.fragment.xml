<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog id="empDialog" title="Employee Details" contentHeight="70%" contentWidth="60%">
        <content>
            <f:SimpleForm editable="true">
                <Label text="Name"/>
                <Input value="{Name}" id="id_Name" editable="{viewModel>/editMode}"/>
                <Label text="Designation"/>
                <Input value="{Designation}" id="id_Designation" editable="{viewModel>/editMode}"/>
                <Label text="Email ID"/>
                <Input value="{Email}" id="id_EmailID" editable="{viewModel>/editMode}"/>
                <Label text="Phone No"/>
                <Input value="{Phone}" id="id_Phone" editable="{viewModel>/editMode}"/>
                <Label text="Salary"/>
                <Input value="{Salary}" id="id_Salary" editable="{viewModel>/editMode}"/>
                <Label text="Status"/>
                <Input value="{Status}" id="id_Status" editable="{viewModel>/editMode}"/>
            </f:SimpleForm>
        </content>
           <Table id="id_Certifications" items="{certifications}">
                <headerToolbar>
                    <Toolbar>
                        <Title text="Certifications"/>
                        <ToolbarSpacer/>
                        <Button text="Add" icon="sap-icon://add" press="addCertifications" type="Emphasized"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="Code"/>
                    </Column>
                    <Column>
                        <Text text="Name"/>
                    </Column>
                </columns>

               <items>
                <ColumnListItem>
                    <cells>
                        <Input value="{code}" editable="{viewModel>/editMode}"/>
                        <Input value="{name}" editable="{viewModel>/editMode}"/>
                    </cells>
                </ColumnListItem>
            </items>
            </Table>
        <beginButton>
            <Button text="Save" icon="sap-icon://save" type="Emphasized" press="onSaveDialog"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" icon="sap-icon://decline" press="onCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>