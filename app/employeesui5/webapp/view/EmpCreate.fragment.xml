<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog id="empDialog" title="Employee Details" contentHeight="70%" contentWidth="40%">
        <content>
            <f:SimpleForm editable="true">
                <Label text="Name"/>
                <Input value="{Name}" id="id_Name"/>
                <Label text="Designation"/>
                <Input value="{Designation}" id="id_Designation"/>
                <Label text="Email ID"/>
                <Input value="{Email}" id="id_EmailID"/>
                <Label text="Phone No"/>
                <Input value="{Phone}" id="id_Phone"/>
                <Label text="Salary"/>
                <Input value="{Salary}" id="id_Salary"/>
                <Label text="Status"/>
                <Input value="{Status}" id="id_Status"/>
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button text="Save" icon="sap-icon://save" type="Emphasized" press="onSaveDialog"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" icon="sap-icon://decline" press="onCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>